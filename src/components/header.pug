header.header
  .container.header__bar
    a.logo(href='#top' aria-label='Keepsake home')
      span.logo__mark K
      | eepsake
    button.burger(type='button' popovertarget='site-menu' aria-controls='site-menu' aria-label='Open menu')
      +icon('menu')(class='burger__open')
      +icon('close')(class='burger__close')
    nav#site-menu.menu(popover aria-label='Main navigation')
      ul.menu__links
        each item in navigation
          li.menu__item
            a.menu__link(href=item.href class={'is-active': item.active} aria-current=item.active ? 'page' : null)= item.label
      +btn('Contact us', '#contact').menu-extra
      a.btn.favourite(href='#contact' aria-label='Favourites')
        +icon('heart')
        span Favourites
      address.menu__contact.menu-extra
        a(href='mailto:hello@keepsake.com') hello@keepsake.com
        a(href='tel:+1234567890') +1 234 567 890
      .social.menu-extra
        each social in socials
          a.social__link(href='#contact' aria-label=social.label)
            +icon(social.icon)
